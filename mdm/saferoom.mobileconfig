<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SafeRoom: system extension approval and DNS proxy policy.

  Install through MDM, as a device (computer-level) profile. macOS accepts the
  System Extensions payload only from MDM.

  Before you deploy:
  - Replace the ProviderConfiguration values with your own (docs/mdm.md).
  - If you build SafeRoom under another team, replace 346JJCHZP7 everywhere.
  - Generate new PayloadUUID values (uuidgen) for your organization.

  The SafeRoom app must be in /Applications, and must launch once (for
  example from a Jamf policy) to submit the extension. This profile then
  approves it with no prompt.
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<!-- 1. Approve the system extension with no user prompt, and stop
		        users from turning it off. -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.system-extension-policy</string>
			<key>PayloadIdentifier</key>
			<string>com.oldsalt.saferoom.profile.sysext</string>
			<key>PayloadUUID</key>
			<string>AA76D848-1B6F-492B-8177-B2D4EC49A1FD</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>SafeRoom system extension</string>
			<key>AllowUserOverrides</key>
			<false/>
			<key>AllowedSystemExtensions</key>
			<dict>
				<key>346JJCHZP7</key>
				<array>
					<string>com.oldsalt.saferoom.dnsproxy</string>
				</array>
			</dict>
			<!-- No AllowedSystemExtensionTypes key: it would approve every
			     network extension from the team, not only SafeRoom's. -->
			<key>NonRemovableSystemExtensions</key>
			<dict>
				<key>346JJCHZP7</key>
				<array>
					<string>com.oldsalt.saferoom.dnsproxy</string>
				</array>
			</dict>
		</dict>

		<!-- 2. Turn on the DNS proxy and give it the SafeRoom policy. The
		        extension receives ProviderConfiguration at each start. -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.dnsProxy.managed</string>
			<key>PayloadIdentifier</key>
			<string>com.oldsalt.saferoom.profile.dnsproxy</string>
			<key>PayloadUUID</key>
			<string>BCAE7B54-2B9C-4F6F-9496-DBD5DB9ED43E</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>SafeRoom DNS proxy</string>
			<key>AppBundleIdentifier</key>
			<string>com.oldsalt.saferoom</string>
			<key>ProviderBundleIdentifier</key>
			<string>com.oldsalt.saferoom.dnsproxy</string>
			<key>ProviderConfiguration</key>
			<dict>
				<!-- The list. HTTPS only. -->
				<key>ListURL</key>
				<string>https://intel.example.com/saferoom/blocklist.txt</string>
				<!-- Optional. A file with the list's SHA-256 in hex. -->
				<key>ListSHA256URL</key>
				<string>https://intel.example.com/saferoom/blocklist.txt.sha256</string>
				<!-- Used when ListURL fails and no list is loaded yet. -->
				<key>ListPath</key>
				<string>/Library/Application Support/SafeRoom/blocklist.txt</string>
				<key>Auth</key>
				<dict>
					<key>Type</key>
					<string>bearer</string>
					<key>Token</key>
					<string>REPLACE-WITH-A-READ-ONLY-TOKEN</string>
				</dict>
				<key>RefreshSeconds</key>
				<integer>3600</integer>
				<!-- 0 = off (the default). If you set it, a feed that changes size
				     on purpose stops every Mac from updating until you raise it. -->
				<key>MaxChangePercent</key>
				<integer>0</integer>
				<key>MaxListMegabytes</key>
				<integer>64</integer>
				<!-- Never blocked. Same forms as the list. -->
				<key>AllowList</key>
				<array>
					<string>example-partner.com</string>
				</array>
				<!-- Add your MDM server and identity provider here. The
				     built-in set already has Apple, Jamf Cloud, and Okta. -->
				<key>NeverBlockHosts</key>
				<array>
					<string>yourcompany.jamfcloud.com</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>SafeRoom DNS blocklist</string>
	<key>PayloadDescription</key>
	<string>Approves the SafeRoom system extension and turns on its DNS proxy.</string>
	<key>PayloadIdentifier</key>
	<string>com.oldsalt.saferoom.profile</string>
	<key>PayloadOrganization</key>
	<string>SafeRoom</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>3ADCFEE7-4DFA-4D1D-A904-51ADC4E72000</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadRemovalDisallowed</key>
	<true/>
</dict>
</plist>
